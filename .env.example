# ============================================================
# TránsitoRAG — variables de entorno (copia a .env y ajusta)
# ============================================================

# --- Base de datos (PostgreSQL 16 + pgvector) ---
# Dentro de docker compose el host es el nombre del servicio: db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/transito_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=transito_rag

# --- Ollama (LLM + embeddings, 100% local) ---
# Dentro de docker compose el host es el nombre del servicio: ollama
OLLAMA_BASE_URL=http://ollama:11434
LLM_MODEL=qwen2.5:7b
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# --- API / CORS ---
# Orígenes permitidos para el frontend (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Ingesta ---
# Directorio (en volumen) donde se guardan los PDFs subidos
UPLOAD_DIR=/app/uploads
# Tamaño de batch para calcular embeddings durante la ingesta
EMBEDDING_BATCH_SIZE=32

# --- Evaluación ---
# Ruta del JSON de resultados de evaluación (lo genera `make eval`)
EVAL_RESULTS_PATH=/app/eval/results.json
